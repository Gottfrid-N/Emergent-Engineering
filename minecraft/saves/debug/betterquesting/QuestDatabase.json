      ],
      "properties:10": {
        "betterquesting:10": {
          "desc:8": "...\n\nYou wake up from what feels like an endless slumber, groggy as can be with nothing to your name.\n\n...\n\nIt feels like you\u0027ve been here before,\nwhen you were stronger, bigger and badder.\nBack when the world bent to your will.\n\n...\n\nYou yearn for that power.\nThe boundless control over the infinite world you find yourself on.\nWill you succumb to mother nature?\nOr will you find the true nature behind it all.",
          "frame:8": "CIRCLE",
          "icon:10": {
            "Count:3": 1,
            "id:8": "minecraft:writable_book"
          },
          "name:8": "A Cyclical Hell",

{"mcVersion":"1.12.2","forgeVersion":"14.23.5.2864","probeVersion":"0.1.24","config":{"mods":true,"items":true,"enchantments":true,"entities":true,"fluids":true,"oredictionary":true,"zentype":true,"zenpackage":true,"globals":true},"mods":[{"modid":"actuallyadditions","name":"Actually Additions","description":"Do you want Automation? Wireless Transport? Better Machines? A cup o\u0027 Coffee? Chests? Better Hoppers? Leaf Blowers? Faster Growth? Plants? Well, Actually Additions has all that and a lot more!","url":"http://github.com/Ellpeck/ActuallyAdditions","version":"1.12.2-r152","authorList":["Ellpeck"],"credits":"Author: Ellpeck; Textures and Models: BootyToast, GlenthorLP, canitzp","requiredMods":[{"label":"forge","version":"unknown","range":"[14.23.5.2836,)"}],"dependencies":[{"label":"fastbench","version":"unknown","range":"[1.3.2,)"}],"dependants":[{"label":"craftingtweaks","version":"unknown","range":"any"}]},{"modid":"ae2fc","name":"AE2 Fluid Crafting","description":"Lets you do Crafting... with Fluids!","url":"","version":"2.6.6-r","authorList":["GlodBlock"],"credits":"phantamanta44","requiredMods":[{"label":"appliedenergistics2","version":"unknown","range":"[v0.56.5,)"}],"dependencies":[],"dependants":[]},{"modid":"ae2stuff","name":"AE2 Stuff Unofficial","description":"Stuff for AE2, now maybe a little bit improved","url":"","version":"0.10","authorList":["serenibyss","bdew"],"credits":"","requiredMods":[{"label":"bdlib","version":"unknown","range":"[1.14.4.1,)"},{"label":"appliedenergistics2","version":"unknown","range":"[rv6-stable-7-extended_life-v0.56.7,)"}],"dependencies":[{"label":"appliedenergistics2","version":"unknown","range":"[rv6-stable-7-extended_life-v0.56.7,)"},{"label":"bdlib","version":"unknown","range":"[1.14.4.1,)"}],"dependants":[]},{"modid":"aether_baubles","name":"The Aether\u0027s Baubles","description":"The Aether and Baubles compatibility addon.","url":"","version":"2.0.1","authorList":["Henrykado"],"credits":"The Aether Team for creating The Aether mod, and Azanor for creating Baubles","requiredMods":[{"label":"aether_legacy","version":"unknown","range":"any"},{"label":"baubles","version":"unknown","range":"any"}],"dependencies":[{"label":"baubles","version":"unknown","range":"any"},{"label":"aether_legacy","version":"unknown","range":"any"},{"label":"lost_aether","version":"unknown","range":"any"}],"dependants":[]},{"modid":"aether_legacy","name":"The Aether","description":"Gilded Games presents the original Aether mod! Up to date for modern Minecraft versions and fully compatible with multiplayer! The Aether is a dimension high in the sky comprised of floating islands! Ascend through a Glowstone portal and begin a new survival adventure packed with new ores, mythical creatures and perilous Dungeons!","url":"https://www.curseforge.com/minecraft/mc-mods/the-aether","version":"v1.5.4.1","authorList":["bconlon, Oscar Payn, Hugo Payn, JellySquid"],"credits":"Credits go to the Aether Collaboration Team (Kingbdogz, Shockah, Kodaichi, Flan, and 303) for creating the original Aether mod, and credits go to Modding Legacy (115kino, KingPhygieBoo, and Lachney) for originally porting and developing the mod in newer versions. InsomniaKitten is also credited with providing the inventory texture.","requiredMods":[],"dependencies":[],"dependants":[]},{"modid":"alfheim","name":"Alfheim","description":"Alfheim is a lighting engine replacement for Minecraft, optimized for performance and fixing many bugs\n\n§lWant to have your own mod or support me?§r\nIf you\u0027re looking for a mod but don\u0027t have the development skills or time, consider commissioning me!\nMy commissions are currently open and I would be happy to create a custom mod to fit your needs as long as you provide assets.\nhttps://www.buymeacoffee.com/desoroxxx/commissions\n\nYou can also support me on a monthly basis by becoming a member.\nTo thank you will have the possibility to access exclusive post and messages, Discord channel for WIP content, and even access to unreleased Prototypes or WIP Projects.\nhttps://www.buymeacoffee.com/desoroxxx/membership\n\nYou can also buy me a hot chocolate\nhttps://www.buymeacoffee.com/desoroxxx.","url":"https://github.com/Red-Studio-Ragnarok/Alfheim","version":"1.6","authorList":["Red Studio"],"credits":"Desoroxxx, kappa-maintainer, embeddedt, Angeline (@jellysquid)","requiredMods":[{"label":"mixinbooter","version":"unknown","range":"[10.6,)"},{"label":"redcore","version":"unknown","range":"[0.6,)"}],"dependencies":[{"label":"mixinbooter","version":"unknown","range":"[10.6,)"},{"label":"redcore","version":"unknown","range":"[0.6,)"}],"dependants":[]},{"modid":"anothertips","name":"Another Tips","description":"A mod that adds tips to the world loading screen","url":"","version":"1.0.5","authorList":[],"credits":"","requiredMods":[{"label":"mixinbooter","version":"unknown","range":"[10.0,)"}],"dependencies":[{"label":"mixinbooter","version":"unknown","range":"[10.0,)"}],"dependants":[]},{"modid":"applecore","name":"AppleCore","description":"An API for modifying the food and hunger mechanics of Minecraft","url":"http://www.minecraftforum.net/forums/mapping-and-modding/minecraft-mods/2222837-applecore-an-api-for-modifying-the-food-and-hunger","version":"3.4.0","authorList":["squeek"],"credits":"","requiredMods":[{"label":"forge","version":"unknown","range":"[14.23,)"}],"dependencies":[{"label":"forge","version":"unknown","range":"[14.23,)"}],"dependants":[]},{"modid":"appliedenergistics2","name":"AE2 Unofficial Extended Life","description":"A Mod about Matter, Energy and using them to conquer the world..","url":"https://github.com/AE2-UEL/Applied-Energistics-2","version":"v0.56.7","authorList":["NotMyWing","Serenibyss","PrototypeTrousers","AlgorithmX2","contributors \u003c3"],"credits":"The AE2:UEL team, AlgorithmX2 \u0026 contributors","requiredMods":[{"label":"forge","version":"unknown","range":"[14.23.5.2847,15.0.0.0)"}],"dependencies":[{"label":"forge","version":"un
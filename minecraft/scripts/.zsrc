 you very much to my Patrons at https://patreon.com/ricksouth and my Github Sponsors at https://github.com/sponsors/ricksouth for supporting the development of this mod: Adara Christine, Kreezcraft.com, Morgan Schetzle, Tyler Behl, Tyler Hadley","requiredMods":[{"label":"forge","version":"unknown","range":"any"},{"label":"collective","version":"unknown","range":"any"}],"dependencies":[{"label":"collective","version":"unknown","range":"any"}],"dependants":[]},{"modid":"betteradvancements","name":"Better Advancements","description":"An improvement to the Advancementscreen","url":"https://github.com/way2muchnoise/BetterAdvancements","version":"0.1.0","authorList":["way2muchnoise"],"credits":"","requiredMods":[],"dependencies":[],"dependants":[]},{"modid":"betterbiomeblend","name":"Betterer Biomer Blender","description":"Increases biome color blending radius and replaces the original blending algorithm with a more efficient one.","url":"https://www.curseforge.com/minecraft/mc-mods/bbb-unforged","version":"1.2.0","authorList":["FionaTheMortal","fonnymunkey"],"credits":"Fuzss","requiredMods":[],"dependencies":[],"dependants":[]},{"modid":"betterchat","name":"Better Chat","description":"Makes chat smoother and gives it a clear background.","url":"","version":"1.4","authorList":["LlamaLad7"],"credits":"","requiredMods":[],"dependencies":[],"dependants":[]},{"modid":"betterhorses","name":"Better Horses","description":"Replace horse controls with something that feels a bit more natural.","url":"","version":"1.0","authorList":["BlueFeuer"],"credits":"Authors of this project","requiredMods":[{"label":"mixinbooter","version":"unknown","range":"[8.0,)"},{"label":"elegant_networking","version":"unknown","range":"any"}],"dependencies":[{"label":"mixinbooter","version":"unknown","range":"[8.0,)"},{"label":"elegant_networking","version":"unknown","range":"any"},{"label":"simpledifficulty","version":"unknown","range":"any"}],"dependants":[]},{"modid":"betterhurttimer","name":"Worse Hurt Timer","description":"i-Frame and hurt animation tweaker, but forked to work with EnderSkills and Mixinbooter.","url":"https://www.curseforge.com/minecraft/mc-mods/better-hurt-timer-bht","version":"1.12.2-1.5.0.3","authorList":["Arekkuusu","roguetictac"],"credits":"","requiredMods":[{"label":"mixinbooter","version":"unknown","range":"any"}],"dependencies":[],"dependants":[]},{"modid":"betterinvisibility","name":"Better Invisibility","description":"Better invisibility improves the invisibility effect by removing particle effects, hiding armor and weapons, and making you invisible to mobs (unless you get too close).","url":"https://curseforge.com/minecraft/mc-mods/better-invisibility","version":"1.0.5","authorList":["Purplicious_Cow, cy4n"],"credits":"","requiredMods":[],"dependencies":[],"dependants":[]},{"modid":"bigreactors","name":"Extreme Reactors","description":"Adds large, multiblock power generation machines to Minecraft. Compatible with Redstone Flux (RF) and Tesla power. This is a port of the 1.7.10 mod Big Reactors from ErogenousBeef","url":"http://zerono.it/extreme-reactors","version":"1.12.2-0.4.5.68","authorList":["ErogenousBeef","ZeroNoRyouki","ABookFreak"],"credits":"powercrystals, skyboy, King_Lemming, \u0026 Calclavia for example code","requiredMods":[{"label":"zerocore","version":"unknown","range":"[1.12.2-0.1.2.9,1.12.2-2.0.0.0)"},{"label":"forge","version":"unknown","range":"[14.23.5.2847,)"}],"dependencies":[{"label":"forge","version":"unknown","range":"[14.23.5.2847,)"},{"label":"zerocore","version":"unknown","range":"[1.12.2-0.1.2.9,1.12.2-2.0.0.0)"},{"label":"computercraft","version":"unknown","range":"any"},{"label":"opencomputers","version":"unknown","range":"[1.7.3.146,)"}],"dependants":[]},{"modid":"bloodarsenal","name":"Blood Arsenal","description":"","url":"","version":"1.12.2-2.2.2-31","authorList":[],"credits":"","requiredMods":[{"label":"bloodmagic","version":"unknown","range":"[1.12.2-2.3.0,)"},{"label":"baubles","version":"unknown","range":"any"}],"dependencies":[{"label":"bloodmagic","version":"unknown","range":"[1.12.2-2.3.0,)"},{"label":"baubles","version":"unknown","range":"any"},{"label":"guideapi","version":"unknown","range":"any"},{"label":"tconstruct","version":"unknown","range":"any"}],"dependants":[]},{"modid":"bloodmagic","name":"Blood Magic: Alchemical Wizardry","description":"Rituals, spells, and more!","url":"http://www.minecraftforum.net/topic/1899223-bloodmagic","version":"1.12.2-2.4.3-105","authorList":["WayofTime","TehNut"],"credits":"","requiredMods":[{"label":"guideapi","version":"unknown","range":"any"}],"dependencies":[{"label":"guideapi","version":"unknown","range":"any"}],"dependants":[]},{"modid":"bogosorter","name":"Inventory Bogo Sorter","description":"A highly configurable and advanced inventory sorter mod","url":"","version":"1.6.2","authorList":["brachy84"],"credits":"Autor of InventoryTweaks","requiredMods":[{"label":"modularui","version":"unknown","range":"[3.1.3,4.0.0)"},{"label":"key_binding_patch","version":"unknown","range":"[1.3.3.3,)"}],"dependencies":[{"label":"modularui","version":"unknown","range":"[3.1.3,4.0.0)"},{"label":"key_binding_patch","version":"unknown","range":"[1.3.3.3,)"}],"dependants":[]},{"modid":"bookshelf","name":"Bookshelf","description":"Bookshelf is a core/library mod, which adds new features and tools into the game for other content creators to work with. The primary focus of this project is to make use of the combined strength of the modded community to create wonderful tools that everyone can use.","url":"http://minecraft.curseforge.com/projects/bookshelf","version":"2.3.590","authorList":["darkhax","lclc98"],"credits":"ChickenBones, CyanideX, iLexiconn, SanAndreasP, VikeStep, jaredlll08","requiredMods":[],"dependencies":[],"dependants":[]},{"modid":"botania","name":"Botania CEu","description":"Botania is a mod that adds nature magic to Minecraft. Long-term support for Minecraft 1.12.","url":"https://github.com/TeamDimensional/B